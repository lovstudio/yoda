{
  "expo": {
    "name": "Yoda Mobile",
    "slug": "yoda-mobile",
    "scheme": "yodamobile",
    "icon": "../../src/assets/images/yoda/yoda-mobile-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yoda Mobile to choose images for your Agent requests."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Yoda Mobile to turn your voice into editable request text.",
          "speechRecognitionPermission": "Allow Yoda Mobile to recognize speech for Agent requests."
        }
      ],
      "expo-localization"
    ],
    "ios": {
      "appleTeamId": "SR95DUC5MJ",
      "bundleIdentifier": "ai.lovstudio.yoda.mobile",
      "buildNumber": "5",
      "requireFullScreen": true,
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": ["public.image"]
          },
          {
            "CFBundleTypeName": "Text Document",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "public.plain-text",
              "public.text",
              "public.source-code",
              "public.json",
              "public.xml"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Yoda Mobile uses the microphone for voice input.",
        "NSSpeechRecognitionUsageDescription": "Yoda Mobile turns speech into editable request text.",
        "NSLocalNetworkUsageDescription": "Yoda Mobile connects directly to the Yoda desktop app when both devices are on the same local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ai.lovstudio.yoda.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "text/*" },
            { "mimeType": "application/json" },
            { "mimeType": "application/xml" },
            { "mimeType": "application/javascript" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F2"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a2a704fb-220c-452d-a752-44739fe0c58e"
      }
    },
    "owner": "markshawn2020"
  }
}
