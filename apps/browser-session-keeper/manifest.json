{
  "manifest_version": 3,
  "name": "Yoda 会话健康",
  "description": "在当前 Chrome Profile 内定时访问已配置的只读页面，并在需要重新登录时提醒。",
  "version": "0.1.0",
  "minimum_chrome_version": "150",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "会话健康"
  },
  "options_page": "options.html"
}
