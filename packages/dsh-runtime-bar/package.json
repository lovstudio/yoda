{
  "name": "dsh-runtime-bar",
  "version": "0.1.0",
  "description": "DSH web plugin: a status bar under the composer — working directory, session state, background jobs, session count. Exposes a service for other plugins to register bar entries.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client-registry.js",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf lib && tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@yoda/runtime-bar": "file:../runtime-bar",
    "clsx": "^2.1.1",
    "cordis": "^4.0.0-rc.7",
    "lightningcss": "^1.31.1",
    "lucide-react": "^0.564.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
